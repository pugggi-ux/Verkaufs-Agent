# Supabase-Projekt-Zugangsdaten (Settings -> API im Supabase-Dashboard)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# BGG-Zugangsdaten werden NICHT hier, sondern als Supabase-Edge-Function-Secret
