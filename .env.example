# Supabase-Projekt-Zugangsdaten (Settings -> API im Supabase-Dashboard)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# BoardGameGeek-Benutzername, dessen Sammlung synchronisiert werden soll
BGG_USERNAME=dein-bgg-username

# BGG verlangt seit Ende Oktober 2025 einen registrierten Authorization-Token
# für die XML-API (auch für die eigene Sammlung). Registrierung unter
# https://boardgamegeek.com/using_the_xml_api
BGG_API_TOKEN=dein-bgg-api-token
